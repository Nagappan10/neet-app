# --- Database ---
DATABASE_URL="postgresql://neet:neet@localhost:5432/neet?schema=public"

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Server ---
PORT="4000"
NODE_ENV="development"
# Comma-separated origins allowed by CORS (the Vite dev server by default)
CORS_ORIGIN="http://localhost:5173"

# --- AI engine (used from Milestone 3 onward) ---
# Provider: anthropic | gemini | openai-compatible
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
AI_API_KEY=""
