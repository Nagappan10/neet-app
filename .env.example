# --- Database ---
DATABASE_URL="postgresql://neet:neet@localhost:5432/neet?schema=public"

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Server ---
PORT="4000"
NODE_ENV="development"
# Comma-separated origins allowed by CORS (the Vite dev server by default)
CORS_ORIGIN="http://localhost:5173"

# --- AI engine (question-generation agent) ---
# Provider: gemini | anthropic | openai-compatible. Swapping is env-only.
AI_PROVIDER="gemini"
# gemini: e.g. gemini-2.0-flash | anthropic: e.g. claude-sonnet-5 | openai: gpt-4o-mini
AI_MODEL="gemini-2.0-flash"
# Get a key: Gemini -> aistudio.google.com  |  Anthropic -> console.anthropic.com
AI_API_KEY=""
# Only for AI_PROVIDER=openai-compatible (OpenAI, GLM, local servers, etc.)
AI_BASE_URL="https://api.openai.com/v1"
