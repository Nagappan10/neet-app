{
  "name": "neet-app",
  "private": true,
  "version": "0.1.0",
  "description": "NEET UG 2026 preparation platform — monorepo",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:seed": "npm run db:seed --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
