{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulse.tracker",
      "infoPlist": {
        "NSMotionUsageDescription": "Pulse uses the motion sensor to count your steps accurately during walks and throughout the day.",
        "NSHealthShareUsageDescription": "Pulse reads step data to show your daily activity.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.pulse.tracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-sensors",
        {
          "motionPermission": "Pulse uses the motion sensor to count your steps accurately during walks and throughout the day."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0A0A0C",
          "dark": {
            "backgroundColor": "#0A0A0C"
          },
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "icon": "./assets/icon.png"
  }
}